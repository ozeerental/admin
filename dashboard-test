<script>
// ── Dates are worked out in local time. toISOString() would shift them to UTC
//    and put Monday mornings in Newcastle into the previous week.
function dISO(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); }
function dParse(s){ return new Date(String(s).slice(0,10) + 'T00:00:00'); }
function dAdd(s, n){ const d = dParse(s); d.setDate(d.getDate() + n); return dISO(d); }
function mondayISO(d){ const x = new Date(d.getFullYear(), d.getMonth(), d.getDate()); x.setDate(x.getDate() - ((x.getDay() + 6) % 7)); return dISO(x); }
function daysBetween(a, b){ return Math.round((dParse(b) - dParse(a)) / 86400000); }
const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function shortDate(s){ const d = dParse(s); return d.getDate() + ' ' + MON[d.getMonth()]; }
function $m(n){ return '$' + Math.round(Number(n) || 0).toLocaleString('en-AU'); }
function esc(t){ return String(t == null ? '' : t).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function sum(arr, f){ return arr.reduce((s, x) => s + (Number(f(x)) || 0), 0); }
const OWN_COL = { biz:'#F5A623', inv:'#60a5fa', part:'#a78bfa' };
function ownType(c){ return !c || !c.externally_owned ? 'biz' : (c.investor_share_pct != null ? 'part' : 'inv'); }

async function loadStats(){
  const sb = window._sb;
  const today = dISO(new Date());
  const thisMon = mondayISO(new Date());
  const lastMon = dAdd(thisMon, -7);
  const firstWeek = dAdd(thisMon, -77);                 // 12 weeks including this one
  const t = new Date();
  const monthStart = dISO(new Date(t.getFullYear(), t.getMonth(), 1));
  const prevStart  = dISO(new Date(t.getFullYear(), t.getMonth() - 1, 1));

  // Greeting
  const hr = t.getHours();
  const who = (document.getElementById('adminEmail').textContent || '').split('@')[0];
  const name = who && who !== 'Loading...' ? who.charAt(0).toUpperCase() + who.slice(1) : '';
  document.getElementById('dHello').textContent = (hr < 12 ? 'Good morning' : hr < 17 ? 'Good afternoon' : 'Good evening') + (name ? ', ' + name : '');
  document.getElementById('dDate').textContent = t.toLocaleDateString('en-AU', {weekday:'long', day:'numeric', month:'long', year:'numeric'})
      + ' · rent week ' + shortDate(thisMon) + ' – ' + shortDate(dAdd(thisMon, 6));

  // Supabase hands back at most 1,000 rows per request, so the all-time lists
  // are read page by page. Otherwise, once there are more than 1,000 rent
  // payments, totals would quietly leave some out. (Read only — nothing is written.)
  const readAll = async (make) => {
    const all = [], seen = new Set();
    for(let from = 0; from < 500000; ){
      const r = await make().order('id', { ascending: true }).range(from, from + 999);
      if(r.error) return r;
      const got = r.data || [];
      const fresh = got.filter(x => !seen.has(x.id));          // never count a row twice
      fresh.forEach(x => seen.add(x.id));
      all.push(...fresh);
      if(!fresh.length) break;
      from += got.length;
    }
    return { data: all, error: null };
  };

  const [carsR, asgR, recentWkR, owingWkR, payR, expR, poR, appsR] = await Promise.all([
    // '*' on purpose: the page keeps working whichever optional columns have been added so far.
    sb.from('cars').select('*'),
    sb.from('car_assignments').select('*,cars(*),drivers(first_name,last_name)'),
    sb.from('rent_weeks').select('id,assignment_id,week_start,amount_due,amount_paid,status').gte('week_start', firstWeek),
    sb.from('rent_weeks').select('assignment_id,week_start,amount_due,amount_paid,status').lt('week_start', thisMon).neq('status', 'Paid'),
    readAll(() => sb.from('rent_payments').select('id,car_id,amount,payment_date,rent_week_id')),
    readAll(() => sb.from('car_expenses').select('id,car_id,amount,category,expense_date')),
    readAll(() => sb.from('owner_payouts').select('id,car_id,amount,payout_date')),
    sb.from('drivers').select('id').eq('status', 'Pending')
  ]);
  const failed = [carsR, asgR, recentWkR, owingWkR, payR, expR, poR, appsR].filter(r => r && r.error);
  if(failed.length){
    console.error('Dashboard: some data could not be loaded', failed.map(r => r.error.message));
    const n = document.createElement('div');
    n.style.cssText = 'margin:-.6rem 0 1rem;padding:.6rem .85rem;border-radius:10px;background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.3);color:#fca5a5;font-size:.82rem;';
    n.textContent = 'Some figures could not be loaded just now (' + failed[0].error.message + '). Refresh the page to try again.';
    const k = document.querySelector('.kpis'); k.parentNode.insertBefore(n, k);
  }
  const cars = carsR.data || [], asg = asgR.data || [], recentWk = recentWkR.data || [], owingWk = owingWkR.data || [];
  const pays = payR.data || [], exps = expR.data || [], pos = poR.data || [], pendingApps = (appsR.data || []).length;
  const asgById = {}; asg.forEach(a => asgById[a.id] = a);
  const active = asg.filter(a => a.status === 'Active');
  const drv = a => a && a.drivers ? (a.drivers.first_name + ' ' + (a.drivers.last_name || '')).trim() : 'Unknown driver';

  // ── Shared figures, worked out once ──
  const thisRows = {}; recentWk.filter(w => w.week_start === thisMon).forEach(w => thisRows[w.assignment_id] = w);
  const monthGot = sum(pays.filter(p => p.payment_date >= monthStart && p.payment_date <= today), p => p.amount);
  // Overdue: weeks that have finished and are not fully paid
  const owing = {};
  owingWk.forEach(w => {
    const left = Number(w.amount_due) - Number(w.amount_paid || 0);
    if(!(left > 0.005)) return;
    (owing[w.assignment_id] = owing[w.assignment_id] || { amt:0, weeks:0, oldest:w.week_start, part:false });
    const o = owing[w.assignment_id];
    o.amt += left; o.weeks += 1;
    if(w.week_start < o.oldest) o.oldest = w.week_start;
    if(Number(w.amount_paid || 0) > 0) o.part = true;
  });
  const owingList = Object.keys(owing).map(id => Object.assign({ a: asgById[id] }, owing[id])).filter(o => o.a)
                          .sort((x, y) => y.amt - x.amt);
  const fleet = cars.filter(c => !c.retired_reason);

  // Each panel is drawn on its own, so a problem in one never blanks the others.
  const panel = (label, fn) => { try { fn(); } catch(e){ console.error('Dashboard — ' + label + ':', e); } };

  // ── Rent for one week only ──
  // Taken from that week's rent records, so a late payment for an earlier week
  // never counts here, even when it is paid this week (it is in Overdue rent
  // until it is paid). A driver whose week the Rent Tracker has not set up yet
  // counts at the same amount the Rent Tracker will set: the weekly rate, or
  // the part-week / agreed first-week amount in the week the car went out.
  const firstWeekDue = a => {
    if(!a.start_date) return Number(a.weekly_rate) || 0;
    const startMon = mondayISO(dParse(a.start_date));
    if(startMon > thisMon) return 0;                               // starts after this week
    const days = 7 - ((dParse(a.start_date).getDay() + 6) % 7);    // Mon→7 … Sun→1
    if(startMon === thisMon && days < 7){
      if(a.first_week_amount != null && a.first_week_amount !== '') return Number(a.first_week_amount) || 0;
      return Math.round((Number(a.weekly_rate) || 0) / 7 * days * 100) / 100;
    }
    return Number(a.weekly_rate) || 0;
  };
  const weekRent = (ws) => {
    const rows = recentWk.filter(w => w.week_start === ws && asgById[w.assignment_id]);
    const per = {};                                                  // assignment → { due, paid }
    rows.forEach(w => {
      const x = per[w.assignment_id] = per[w.assignment_id] || { due:0, paid:0 };
      x.due += Number(w.amount_due) || 0; x.paid += Math.min(Number(w.amount_paid) || 0, Number(w.amount_due) || 0);
    });
    if(ws === thisMon) active.forEach(a => {
      if(per[a.id]) return;
      const due = firstWeekDue(a);
      if(due > 0) per[a.id] = { due, paid:0 };
    });
    const list = Object.values(per);
    return { due: sum(list, x => x.due), paid: sum(list, x => x.paid),
             left: list.filter(x => x.due - x.paid > 0.005).length, drivers: list.length };
  };

  panel('this week', () => {
    const wk = weekRent(thisMon), last = weekRent(lastMon);
    const toCome = Math.max(0, wk.due - wk.paid);
    document.getElementById('kWeekExp').textContent = $m(wk.due);
    document.getElementById('kWeek').textContent = $m(wk.paid);
    document.getElementById('kWeekNote').innerHTML =
        (wk.drivers === 0 ? 'No rent is due this week'
          : toCome > 0.5 ? '<b>' + $m(toCome) + '</b> still to come from <b>' + wk.left + '</b> driver' + (wk.left === 1 ? '' : 's')
          : '<span class="delta up">All paid for this week</span>')
      + '<br>Last week: <b>' + $m(last.paid) + '</b> of ' + $m(last.due) + ' paid'
      + (last.due - last.paid > 0.5 ? ' · the rest is in Overdue rent' : '');
    document.getElementById('kWeekBar').style.width = (wk.due > 0 ? Math.min(100, wk.paid / wk.due * 100) : 0) + '%';
  });

  panel('this month', () => {
    const prevTotal = sum(pays.filter(p => p.payment_date >= prevStart && p.payment_date < monthStart), p => p.amount);
    document.getElementById('kMonth').textContent = $m(monthGot);
    document.getElementById('kMonthNote').innerHTML = 'So far in ' + t.toLocaleDateString('en-AU', {month:'long'})
        + '<br>' + dParse(prevStart).toLocaleDateString('en-AU', {month:'long'}) + ' total: <b>' + $m(prevTotal) + '</b>';
  });

  panel('overdue', () => {
    // A driver is overdue once a rent week has finished (Sunday has passed) and
    // it is not fully paid — that is, they are a week or more late.
    const overdueTotal = sum(owingList, o => o.amt);
    document.getElementById('kOverdue').textContent = $m(overdueTotal);
    document.getElementById('kOverdueBox').classList.toggle('bad', overdueTotal > 0);
    document.getElementById('kOverdueBox').classList.toggle('good', overdueTotal <= 0);
    document.getElementById('kOverdueNote').innerHTML = overdueTotal > 0
        ? '<b>' + owingList.length + '</b> driver' + (owingList.length === 1 ? ' is' : 's are') + ' a week or more late'
        : 'Everyone is paid up';
    const SHOW = 6;
    let html = owingList.slice(0, SHOW).map(o => {
      const c = o.a.cars || {};
      const late = o.weeks === 1
          ? 'week of ' + shortDate(o.oldest) + (o.part ? ' part paid' : ' unpaid')
          : o.weeks + ' weeks unpaid since ' + shortDate(o.oldest);
      return '<a class="od" href="rent-tracker.html"><span style="min-width:0">'
        + '<div class="nm">' + esc(drv(o.a)) + '</div>'
        + '<div class="sub">' + esc((c.rego ? c.rego + ' · ' : '') + late + (o.a.status !== 'Active' ? ' · rental ended' : '')) + '</div></span>'
        + '<span class="amt">' + $m(o.amt) + '</span></a>';
    }).join('');
    if(owingList.length > SHOW){
      const rest = owingList.slice(SHOW);
      html += '<a class="od-more" href="rent-tracker.html">+ ' + rest.length + ' more driver' + (rest.length === 1 ? '' : 's')
            + ' owing ' + $m(sum(rest, o => o.amt)) + ' — see Rent Tracker ›</a>';
    }
    // Late rent that came in this week (paid this week for an earlier week).
    // It is not counted in this week's rent, so it is shown here instead.
    const weekById = {}; recentWk.forEach(w => weekById[w.id] = w.week_start);
    const caught = sum(pays.filter(p => p.rent_week_id && p.payment_date >= thisMon && p.payment_date <= today
                                     && !(weekById[p.rent_week_id] >= thisMon)), p => p.amount);
    if(caught > 0.5) html += '<div class="od-caught">✓ ' + $m(caught) + ' of late rent for earlier weeks was paid this week</div>';
    document.getElementById('odList').innerHTML = html;
  });

  panel('net', () => {
    // Rent received less running costs; car purchases are left out.
    const monthCosts = sum(exps.filter(e => e.expense_date >= monthStart && e.expense_date <= today && (e.category || '') !== 'Purchase Price'), e => e.amount);
    const net = monthGot - monthCosts;
    document.getElementById('kNet').textContent = (net < 0 ? '-' : '') + $m(Math.abs(net));
    document.getElementById('kNetBox').classList.toggle('bad', net < 0);
    document.getElementById('kNetNote').innerHTML = 'Rent <b>' + $m(monthGot) + '</b> less running costs <b>' + $m(monthCosts) + '</b>';
  });

  panel('fleet', () => {
    const n = st => fleet.filter(c => c.status === st).length;
    const rented = n('Rented'), avail = n('Available'), maint = n('Maintenance');
    const other = fleet.length - rented - avail - maint;
    const util = fleet.length ? Math.round(rented / fleet.length * 100) : 0;
    document.getElementById('fUtil').innerHTML = util + '%<small>earning</small>';
    document.getElementById('fUtilSub').textContent = rented + ' of ' + fleet.length + ' cars are rented out right now';
    const segs = [['Rented', rented, '#F5A623'], ['Available', avail, '#4ade80'], ['Maintenance', maint, '#94a3b8']];
    if(other > 0) segs.push(['Other', other, '#475569']);
    document.getElementById('fBar').innerHTML = segs.filter(x => x[1] > 0)
        .map(x => '<i title="' + x[0] + ': ' + x[1] + '" style="flex:' + x[1] + ';background:' + x[2] + '"></i>').join('');
    document.getElementById('fKey').innerHTML = segs.map(x => '<span><i style="background:' + x[2] + '"></i>' + x[0] + '</span><b>' + x[1] + '</b>').join('');
    const ot = t2 => fleet.filter(c => ownType(c) === t2).length;
    document.getElementById('fSplit').innerHTML =
        '<span><i style="background:' + OWN_COL.biz + '"></i>Business <b>' + ot('biz') + '</b></span>'
      + '<span><i style="background:' + OWN_COL.inv + '"></i>Investor <b>' + ot('inv') + '</b></span>'
      + '<span><i style="background:' + OWN_COL.part + '"></i>Partnership <b>' + ot('part') + '</b></span>';
  });

  panel('weekly rent chart', () => {
    const weeks = []; for(let i = 11; i >= 0; i--) weeks.push(dAdd(thisMon, -7 * i));
    const byWeek = weeks.map(ws => {
      const rows = recentWk.filter(w => w.week_start === ws);
      return { ws, due: sum(rows, w => w.amount_due), got: sum(rows, w => w.amount_paid) };
    });
    drawChart(byWeek, thisMon);
    const done = byWeek.filter(w => w.ws < thisMon);
    const dueAll = sum(done, w => w.due), gotAll = sum(done, w => w.got);
    document.getElementById('chartFoot').innerHTML =
        '<span>Collected <b>' + (dueAll ? Math.round(gotAll / dueAll * 100) : 0) + '%</b> of rent due over the last 11 finished weeks</span>'
      + '<span>Average <b>' + $m(done.length ? gotAll / done.length : 0) + '</b> a week</span>';
  });

  panel('needs attention', () => {
    const items = [];
    owingList.forEach(o => {
      const c = o.a.cars || {};
      items.push({ cls:'red', ic:'$', href:'rent-tracker.html',
        t1: drv(o.a) + ' owes rent', t2: (c.rego || '') + ' · ' + o.weeks + ' unpaid week' + (o.weeks === 1 ? '' : 's') + (o.a.status !== 'Active' ? ' · rental ended' : ''),
        amt: $m(o.amt), sort: 1e9 + o.amt });
    });
    // Cars standing idle: available, no active rental, free since the last return
    fleet.filter(c => c.status === 'Available' && !active.some(a => a.car_id === c.id)).forEach(c => {
      const ends = asg.filter(a => a.car_id === c.id && a.end_date && a.status !== 'Active').map(a => String(a.end_date).slice(0, 10)).sort();
      const cands = [];
      if(ends.length) cands.push(ends[ends.length - 1]);
      if(c.available_from) cands.push(String(c.available_from).slice(0, 10));
      const since = cands.length ? cands.sort()[cands.length - 1] : String(c.created_at || today).slice(0, 10);
      const days = Math.max(0, daysBetween(since, today));
      if(!(days >= 3)) return;
      const missed = Number(c.weekly_rate || 0) * days / 7;
      items.push({ cls:'amber', ic:'⏱', href:'cars.html',
        t1: (c.rego || 'A car') + ' is free', t2: 'About ' + $m(missed) + ' rent missed · ' + (c.make_model || '') + ' ' + (c.year || ''),
        amt: days + ' days', sort: 5e8 + days });
    });
    // Money still to pay investors and partners
    cars.filter(c => c.externally_owned).forEach(c => {
      const inc = sum(pays.filter(p => p.car_id === c.id), p => p.amount);
      const costs = sum(exps.filter(e => e.car_id === c.id && (e.category || '') !== 'Purchase Price'), e => e.amount);
      const paid = sum(pos.filter(p => p.car_id === c.id), p => p.amount);
      const after = inc - costs, feePct = Number(c.service_fee_pct) || 0;
      const part = c.investor_share_pct != null;
      let due;
      if(part){
        const share = after * Number(c.investor_share_pct) / 100;
        due = share - ((feePct > 0 && share > 0) ? share * feePct / 100 : 0);
      } else {
        due = after - (feePct > 0 ? after * feePct / 100 : 0);
      }
      const left = due - paid;
      if(!(left >= 1)) return;
      items.push({ cls: part ? 'purple' : 'blue', ic: part ? '⇄' : '↗', href:'finance.html',
        t1: 'Pay ' + (c.owner_name || 'the investor'), t2: (c.rego || '') + ' · ' + (part ? 'partnership ' + Number(c.investor_share_pct) + '%' : 'investor car'),
        amt: $m(left), sort: 1e8 + left });
    });
    if(pendingApps > 0){
      items.push({ cls:'amber', ic:'✎', href:'drivers.html',
        t1: pendingApps + ' driver application' + (pendingApps === 1 ? '' : 's') + ' waiting', t2: 'Most drivers expect an answer within the hour',
        amt: '', sort: 9e8 });
    }
    items.sort((x, y) => y.sort - x.sort);
    document.getElementById('aCount').textContent = items.length ? items.length + ' item' + (items.length === 1 ? '' : 's') : '';
    document.getElementById('alerts').innerHTML = items.length
      ? items.map(i => '<a class="alert ' + i.cls + '" href="' + i.href + '"><span class="ic">' + i.ic + '</span>'
          + '<span class="tx"><div class="t1">' + esc(i.t1) + '</div><div class="t2">' + esc(i.t2) + '</div></span>'
          + (i.amt ? '<span class="amt">' + esc(i.amt) + '</span>' : '') + '</a>').join('')
      : '<div class="all-clear"><b>All clear</b>Nobody owes rent, no car is standing idle, and nothing is waiting.</div>';
  });

  panel('overpaid', () => {
    // Same sums as the settlement in Car Finance: rent, less running costs,
    // their share (and service fee), less what has been paid to them.
    // Every payment recorded to them counts, so an advance or upfront payment
    // shows here for as long as it is more than the share they have earned.
    const rows = [];
    cars.filter(c => c.externally_owned).forEach(c => {
      const inc = sum(pays.filter(p => p.car_id === c.id), p => p.amount);
      const costs = sum(exps.filter(e => e.car_id === c.id && (e.category || '') !== 'Purchase Price'), e => e.amount);
      const mine = pos.filter(p => p.car_id === c.id);
      const paid = sum(mine, p => p.amount);
      if(!(paid > 0)) return;                                   // only people who have been paid something
      const lastPaid = mine.map(p => String(p.payout_date || '').slice(0, 10)).filter(Boolean).sort().pop() || null;
      const after = inc - costs, feePct = Number(c.service_fee_pct) || 0;
      const part = c.investor_share_pct != null;
      let due;
      if(part){
        const share = after * Number(c.investor_share_pct) / 100;
        due = share - ((feePct > 0 && share > 0) ? share * feePct / 100 : 0);
      } else {
        due = after - (feePct > 0 ? after * feePct / 100 : 0);
      }
      const over = paid - due;
      if(!(over >= 1)) return;
      rows.push({ c, part, due, paid, over, lastPaid });
    });
    rows.sort((a, b) => b.over - a.over);
    const total = sum(rows, r => Math.round(r.over));          // adds up exactly to the rows shown
    document.getElementById('overList').innerHTML = rows.length
      ? rows.map(r => '<a class="over" href="finance.html"><span class="own" style="background:' + (r.part ? OWN_COL.part : OWN_COL.inv) + '"></span>'
          + '<span style="min-width:0"><div class="nm">' + esc(r.c.owner_name || 'Owner not named') + '</div>'
          + '<div class="sub">' + esc((r.c.rego || '') + ' · ' + (r.part ? 'partnership ' + Number(r.c.investor_share_pct) + '%' : 'investor car')
              + (r.lastPaid ? ' · last paid ' + shortDate(r.lastPaid) : '')) + '</div>'
          + '<div class="sub">Paid ' + $m(r.paid) + ' · their share so far ' + (r.due < 0 ? '-' : '') + $m(Math.abs(r.due)) + '</div></span>'
          + '<span class="rt"><div class="amt">' + $m(r.over) + '</div><div class="lbl">paid ahead</div></span></a>').join('')
        + (rows.length > 1 ? '<div class="panel-sub" style="grid-column:1/-1;text-align:right">Total paid ahead: <b style="color:#f87171">' + $m(total) + '</b></div>' : '')
      : '<div class="over-ok"><b>All payouts are correct.</b> No investor or partner has been paid more than their share, and no advance is outstanding.</div>';
  });

  panel('on the road', () => {
    const road = active.slice().sort((a, b) => drv(a).localeCompare(drv(b)));
    document.getElementById('road').innerHTML = road.length ? road.map(a => {
      const c = a.cars || {}, wk = thisRows[a.id], ow = owing[a.id];
      let pill;
      if(ow && ow.amt > 0) pill = '<span class="pill behind"><i></i>Behind ' + $m(ow.amt) + '</span>';
      else if(wk && wk.status === 'Paid') pill = '<span class="pill paid"><i></i>Paid this week</span>';
      else if(wk && wk.status === 'Partial') pill = '<span class="pill part"><i></i>Part paid</span>';
      else pill = '<span class="pill unpaid"><i></i>Due this week</span>';
      return '<a href="rent-tracker.html"><span class="own" style="background:' + OWN_COL[ownType(c)] + '"></span>'
        + '<span style="min-width:0"><div class="nm">' + esc(drv(a)) + '</div><div class="car">' + esc((c.rego || '') + ' · ' + (c.make_model || '') + ' ' + (c.year || '')) + (a.start_date ? ' · since ' + shortDate(a.start_date) : '') + '</div></span>'
        + '<span class="rt"><div class="rate">$' + Number(a.weekly_rate || 0) + '/wk</div>' + pill + '</span></a>';
    }).join('') : '<div class="road-empty">No cars are out with drivers right now.</div>';
  });
}

function drawChart(data, thisMon){
  const el = document.getElementById('chart');
  const top = Math.max(1, ...data.map(d => Math.max(d.due, d.got)));
  const step = top <= 500 ? 100 : top <= 1500 ? 250 : top <= 3000 ? 500 : 1000;
  const max = Math.ceil(top / step) * step;
  const plotH = el.clientHeight - 22;
  let html = '';
  for(let v = 0; v <= max; v += step * (max / step > 4 ? 2 : 1)){
    const y = plotH - (v / max) * plotH;
    html += '<div class="grid" style="top:' + y + 'px"></div><div class="tick" style="top:' + y + 'px">' + (v >= 1000 ? '$' + (v / 1000) + 'k' : '$' + v) + '</div>';
  }
  html += '<div class="cols">' + data.map((d, i) =>
      '<div class="col' + (d.ws === thisMon ? ' now' : '') + '" data-i="' + i + '">'
    + '<span class="due" style="height:' + (d.due / max * 100) + '%"></span>'
    + '<span class="got" style="height:' + (d.got / max * 100) + '%"></span>'
    + '<span class="lbl">' + shortDate(d.ws) + '</span></div>').join('') + '</div>'
    + '<div class="tip" id="tip"></div>';
  el.innerHTML = html;
  const tip = document.getElementById('tip');
  const show = col => {
    el.querySelectorAll('.col.on').forEach(c => c.classList.remove('on'));
    if(!col){ tip.style.display = 'none'; return; }
    col.classList.add('on');
    const d = data[+col.dataset.i], short = d.due - d.got;
    tip.innerHTML = '<b>Week of ' + shortDate(d.ws) + (d.ws === thisMon ? ' (this week)' : '') + '</b>'
      + '<div class="row"><span>Due</span><em>' + $m(d.due) + '</em></div>'
      + '<div class="row"><span>Collected</span><em>' + $m(d.got) + '</em></div>'
      + (short > 0.5 ? '<div class="row"><span>' + (d.ws === thisMon ? 'Still to come' : 'Short') + '</span><em>' + $m(short) + '</em></div>' : '');
    tip.style.display = 'block';
    const r = col.getBoundingClientRect(), pr = el.getBoundingClientRect();
    let x = r.left - pr.left + r.width / 2 - tip.offsetWidth / 2;
    x = Math.max(0, Math.min(x, el.clientWidth - tip.offsetWidth));
    tip.style.left = x + 'px'; tip.style.top = '0px';
  };
  el.querySelectorAll('.col').forEach(c => {
    c.addEventListener('mouseenter', () => show(c));
    c.addEventListener('click', e => { e.stopPropagation(); show(c.classList.contains('on') ? null : c); });
  });
  el.addEventListener('mouseleave', () => show(null));
  document.addEventListener('click', () => show(null));
}
</script>

