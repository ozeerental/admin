<script>
// Mobile sidebar toggle
(function(){
  // Add overlay div
  var overlay = document.createElement('div');
  overlay.className = 'sidebar-overlay';
  overlay.id = 'sidebarOverlay';
  overlay.onclick = function(){ closeSidebar(); };
  document.body.appendChild(overlay);

  // Add hamburger button to topbar
  var topbar = document.querySelector('.topbar');
  if(topbar){
    var btn = document.createElement('button');
    btn.className = 'mob-menu-btn';
    btn.innerHTML = '☰';
    btn.onclick = function(){ toggleSidebar(); };
    // Wrap existing content in topbar-left
    var existing = topbar.firstElementChild;
    var wrap = document.createElement('div');
    wrap.className = 'topbar-left';
    wrap.appendChild(btn);
    if(existing) wrap.appendChild(existing);
    topbar.insertBefore(wrap, topbar.firstChild);
  }

  function toggleSidebar(){
    var sb = document.querySelector('.sidebar');
    var ov = document.getElementById('sidebarOverlay');
    if(sb){ sb.classList.toggle('open'); }
    if(ov){ ov.classList.toggle('open'); }
  }
  function closeSidebar(){
    var sb = document.querySelector('.sidebar');
    var ov = document.getElementById('sidebarOverlay');
    if(sb){ sb.classList.remove('open'); }
    if(ov){ ov.classList.remove('open'); }
  }
  // Close sidebar when nav link clicked
  document.querySelectorAll('.sidebar-nav a').forEach(function(a){
    a.addEventListener('click', function(){ if(window.innerWidth<=900) closeSidebar(); });
  });
})();
</script>

