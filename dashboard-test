<title>Dashboard — Ozee Rentals Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:"Barlow",sans-serif;background:#04090F;color:#fff;min-height:100vh;display:flex;flex-direction:column;}
/* TOPBAR */
.topbar{background:#07101e;border-bottom:1px solid rgba(245,166,35,.15);padding:1rem 1.5rem;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:200;}
.topbar img{height:36px;filter:brightness(0) invert(1);}
.topbar-right{display:flex;align-items:center;gap:1rem;}
.topbar-user{font-size:.82rem;color:rgba(255,255,255,.5);}
.topbar-logout{font-size:.78rem;color:#F5A623;text-decoration:none;letter-spacing:1px;text-transform:uppercase;padding:.4rem .9rem;border:1px solid rgba(245,166,35,.3);transition:all .2s;}
.topbar-logout:hover{background:rgba(245,166,35,.1);}
/* LAYOUT */
.app{display:flex;flex:1;}
/* SIDEBAR */
.sidebar{width:220px;background:#07101e;border-right:1px solid rgba(255,255,255,.06);padding:1.5rem 0;flex-shrink:0;}
.sidebar-nav{list-style:none;}
.sidebar-nav li a{display:flex;align-items:center;gap:.75rem;padding:.9rem 1.5rem;color:rgba(255,255,255,.5);text-decoration:none;font-size:.88rem;font-weight:600;letter-spacing:.5px;transition:all .2s;border-left:3px solid transparent;}
.sidebar-nav li a:hover{color:#fff;background:rgba(255,255,255,.04);}
.sidebar-nav li a.active{color:#F5A623;background:rgba(245,166,35,.08);border-left-color:#F5A623;}
.sidebar-nav li a .s-icon{font-size:1.1rem;width:20px;text-align:center;}
.sidebar-divider{margin:1rem 1.5rem;border:none;border-top:1px solid rgba(255,255,255,.06);}
/* MAIN */
.main{flex:1;padding:2rem;overflow-y:auto;}
.page-title{font-family:"Barlow Condensed",sans-serif;font-size:2.2rem;font-weight:900;text-transform:uppercase;letter-spacing:-1px;margin-bottom:.3rem;}
.page-title span{color:#F5A623;}
.page-sub{color:rgba(255,255,255,.4);font-size:.88rem;margin-bottom:2rem;}
/* CARDS */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:2rem;}
.stat-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);padding:1.5rem;position:relative;overflow:hidden;}
.stat-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,#F5A623,#D4880A);}
.stat-label{font-size:.7rem;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:.5rem;}
.stat-val{font-family:"Barlow Condensed",sans-serif;font-size:2.5rem;font-weight:900;color:#F5A623;letter-spacing:-1px;}
.stat-sub{font-size:.8rem;color:rgba(255,255,255,.3);margin-top:.3rem;}
/* TABLE */
.table-wrap{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:2px;overflow:hidden;}
.table-header{padding:1.25rem 1.5rem;border-bottom:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.75rem;}
.table-title{font-family:"Barlow Condensed",sans-serif;font-size:1.2rem;font-weight:900;text-transform:uppercase;letter-spacing:1px;}
table{width:100%;border-collapse:collapse;}
th{text-align:left;padding:.9rem 1rem;font-size:.7rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.35);border-bottom:1px solid rgba(255,255,255,.07);}
td{padding:.9rem 1rem;font-size:.88rem;border-bottom:1px solid rgba(255,255,255,.05);color:rgba(255,255,255,.8);vertical-align:middle;}
tr:hover td{background:rgba(255,255,255,.03);}
/* BADGES */
.badge{padding:.25rem .7rem;font-size:.68rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-radius:1px;}
.badge-green{background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.3);}
.badge-yellow{background:rgba(245,166,35,.15);color:#F5A623;border:1px solid rgba(245,166,35,.3);}
.badge-red{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.3);}
.badge-blue{background:rgba(59,130,246,.15);color:#60a5fa;border:1px solid rgba(59,130,246,.3);}
.badge-gray{background:rgba(255,255,255,.08);color:rgba(255,255,255,.5);border:1px solid rgba(255,255,255,.12);}
/* BUTTONS */
.btn{padding:.5rem 1rem;font-size:.78rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;cursor:pointer;border:none;font-family:"Barlow",sans-serif;transition:all .2s;}
.btn-gold{background:linear-gradient(135deg,#F5A623,#D4880A);color:#000;}
.btn-gold:hover{box-shadow:0 4px 20px rgba(245,166,35,.4);}
.btn-outline{background:transparent;border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.7);}
.btn-outline:hover{border-color:#F5A623;color:#F5A623;}
.btn-danger{background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);color:#f87171;}
.btn-danger:hover{background:rgba(239,68,68,.25);}
.btn-sm{padding:.35rem .8rem;font-size:.72rem;}
/* MODAL */
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:1000;align-items:center;justify-content:center;padding:2rem;}
.modal.open{display:flex;}
.modal-box{background:#0d1526;border:1px solid rgba(245,166,35,.2);width:100%;max-width:680px;max-height:90vh;overflow-y:auto;}
.modal-head{padding:1.5rem;border-bottom:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;align-items:center;}
.modal-head h3{font-family:"Barlow Condensed",sans-serif;font-size:1.5rem;font-weight:900;text-transform:uppercase;}
.modal-close{background:none;border:none;color:rgba(255,255,255,.5);font-size:1.5rem;cursor:pointer;}
.modal-body{padding:1.5rem;}
.modal-foot{padding:1.5rem;border-top:1px solid rgba(255,255,255,.08);display:flex;justify-content:flex-end;gap:.75rem;}
/* FORM */
.form-group{margin-bottom:1.25rem;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;}
.form-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;}
.form-label{display:block;font-size:.75rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:.5rem;}
.form-label .req{color:#F5A623;}
.form-input,.form-select,.form-textarea{width:100%;padding:.75rem;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff;font-size:.95rem;font-family:"Barlow",sans-serif;border-radius:2px;}
.form-input:focus,.form-select:focus,.form-textarea:focus{outline:none;border-color:#F5A623;}
.form-select option{background:#0d1526;}
.form-textarea{resize:vertical;min-height:80px;}
/* CHECKS */
.check-group{display:flex;flex-wrap:wrap;gap:1rem;}
.check-item{display:flex;align-items:center;gap:.5rem;}
.check-item input{width:17px;height:17px;cursor:pointer;accent-color:#F5A623;}
.check-item label{font-size:.88rem;color:rgba(255,255,255,.7);cursor:pointer;}
/* FILE */
.file-zone{border:2px dashed rgba(255,255,255,.15);padding:1.5rem;text-align:center;cursor:pointer;transition:all .2s;}
.file-zone:hover{border-color:#F5A623;background:rgba(245,166,35,.05);}
.file-zone input{display:none;}
/* SEARCH */
.search-bar{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;}
.search-input{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff;padding:.6rem 1rem;font-family:"Barlow",sans-serif;font-size:.88rem;min-width:220px;}
.search-input:focus{outline:none;border-color:#F5A623;}
/* LOADING */
.loading-row td{text-align:center;color:rgba(255,255,255,.3);font-style:italic;padding:3rem;}
/* EMPTY */
.empty-state{text-align:center;padding:4rem 2rem;color:rgba(255,255,255,.3);}
.empty-icon{font-size:3rem;margin-bottom:1rem;opacity:.3;}
@media(max-width:900px){.form-row,.form-row-3{grid-template-columns:1fr;}}

/* ═══════════════════════════════════════
   MOBILE RESPONSIVE — ALL ADMIN PAGES
   Target: iPhone and Android phones
═══════════════════════════════════════ */

/* Hamburger button */
.mob-menu-btn{
  display:none;
  background:none;border:none;
  color:#fff;font-size:1.4rem;
  cursor:pointer;padding:4px 8px;
  line-height:1;
}

/* Mobile overlay for sidebar */
.sidebar-overlay{
  display:none;
  position:fixed;inset:0;
  background:rgba(0,0,0,.6);
  z-index:998;
}
.sidebar-overlay.open{display:block;}

@media(max-width:900px){
  /* ── LAYOUT ── */
  .app{flex-direction:column;}
  
  /* ── SIDEBAR ── */
  .sidebar{
    position:fixed;top:0;left:-260px;
    width:260px!important;height:100vh;
    z-index:999;transition:left .3s ease;
    overflow-y:auto;
  }
  .sidebar.open{left:0;}
  .mob-menu-btn{display:block;}
  
  /* ── TOP BAR ── */
  .topbar{
    display:flex!important;
    justify-content:space-between;
    align-items:center;
    padding:12px 16px!important;
    position:sticky;top:0;z-index:100;
  }
  .topbar-left{display:flex;align-items:center;gap:10px;}
  
  /* ── MAIN ── */
  main{padding:20px 16px!important;overflow-x:hidden;}
  
  /* ── PAGE HEADER ── */
  .page-header{margin-bottom:24px!important;}
  .page-header h1{font-size:1.6rem!important;}
  .page-header p{font-size:.85rem!important;}
  
  /* ── STAT CARDS ── */
  .stats-row{
    display:grid!important;
    grid-template-columns:1fr 1fr!important;
    gap:12px!important;
  }
  .stat-card{padding:18px!important;}
  .stat-card .stat-val{font-size:2rem!important;}
  
  /* ── DASHBOARD PANELS ── */
  .dash-panels{
    grid-template-columns:1fr!important;
    gap:16px!important;
  }
  
  /* ── TABLES — convert to card view ── */
  .table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
  
  table{width:100%;border-collapse:collapse;}
  
  /* Hide less important columns on mobile */
  table th:nth-child(3),
  table td:nth-child(3),
  table th:nth-child(4),
  table td:nth-child(4){display:none;}
  
  /* Make table cells bigger for touch */
  table td,table th{
    padding:14px 10px!important;
    font-size:.82rem!important;
  }
  
  /* ── DRIVERS TABLE — show approve/reject as full-width buttons ── */
  #driversTable tr{position:relative;}
  #driversTable td:last-child{
    display:flex!important;
    flex-direction:column;
    gap:8px;
    padding:10px!important;
  }
  #driversTable td:last-child .btn{
    width:100%!important;
    text-align:center;
    padding:10px!important;
    font-size:.82rem!important;
  }
  
  /* ── CARS TABLE ── */
  .car-photo-thumb{width:50px!important;height:40px!important;}
  
  /* ── MODALS ── */
  .modal-box{
    width:95vw!important;
    max-width:95vw!important;
    max-height:90vh!important;
    overflow-y:auto!important;
    margin:5vh auto!important;
    padding:20px!important;
  }
  .modal-foot{
    flex-direction:column!important;
    gap:10px!important;
  }
  .modal-foot .btn{
    width:100%!important;
    text-align:center;
    padding:14px!important;
    font-size:.9rem!important;
  }
  
  /* ── FORM GRIDS ── */
  .form-grid{grid-template-columns:1fr!important;}
  .form-grid-2{grid-template-columns:1fr!important;}
  
  /* ── BUTTONS ── */
  .btn-sm{padding:10px 14px!important;font-size:.78rem!important;}
  
  /* ── FILTERS ROW ── */
  .filters-row{
    flex-direction:column!important;
    gap:10px!important;
    align-items:stretch!important;
  }
  .filters-row input,
  .filters-row select{width:100%!important;}
  
  /* ── PAGE ACTIONS ── */
  .page-actions{
    flex-direction:column!important;
    gap:10px!important;
    align-items:stretch!important;
  }
  .page-actions .btn{width:100%;text-align:center;}
  
  /* ── FINES TABLE ── */
  .fines-table th:nth-child(5),
  .fines-table td:nth-child(5),
  .fines-table th:nth-child(6),
  .fines-table td:nth-child(6){display:none;}
  
  /* ── ASSIGNMENTS ── */
  .assign-table th:nth-child(4),
  .assign-table td:nth-child(4){display:none;}
}

@media(max-width:480px){
  .stats-row{grid-template-columns:1fr!important;}
  .page-header h1{font-size:1.4rem!important;}
  table th:nth-child(2),
  table td:nth-child(2){font-size:.75rem!important;}
}

/* ═══ DASHBOARD ═══ */
.dash-head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap;margin-bottom:1.6rem;}
.dash-hello{font-size:.8rem;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:.35rem;}
.dash-date{color:rgba(255,255,255,.45);font-size:.88rem;margin-top:.2rem;}
.quick{display:flex;gap:.5rem;flex-wrap:wrap;}
.quick a{display:inline-flex;align-items:center;gap:.45rem;padding:.6rem .95rem;font-size:.75rem;font-weight:700;letter-spacing:1px;
  text-transform:uppercase;text-decoration:none;color:rgba(255,255,255,.8);border:1px solid rgba(255,255,255,.14);border-radius:10px;
  background:rgba(255,255,255,.03);transition:all .2s;}
.quick a:hover{border-color:#F5A623;color:#F5A623;}
.quick a.primary{background:linear-gradient(135deg,#F5A623,#D4880A);color:#000;border-color:transparent;}

.panel{background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:1.25rem 1.3rem;min-width:0;}
.panel-head{display:flex;justify-content:space-between;align-items:baseline;gap:.5rem .75rem;margin-bottom:1rem;flex-wrap:wrap;}
.panel-title{font-family:"Barlow Condensed",sans-serif;font-size:1.15rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;}
.panel-link{font-size:.72rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#F5A623;text-decoration:none;white-space:nowrap;}
.panel-link:hover{text-decoration:underline;}
.panel-sub{font-size:.78rem;color:rgba(255,255,255,.45);}

/* KPI row — this week and overdue side by side, the two monthly figures stacked */
.kpis{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1.3fr) minmax(0,1fr);grid-template-areas:"week over month" "week over net";gap:1rem;margin-bottom:1rem;}
#kWeekBox{grid-area:week;} #kOverdueBox{grid-area:over;} #kMonthBox{grid-area:month;} #kNetBox{grid-area:net;}
.wk-figs{display:flex;align-items:flex-end;gap:.6rem 1.6rem;flex-wrap:wrap;}
.wk-cap{font-size:.68rem;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:rgba(255,255,255,.45);margin-top:.3rem;}
.kpi.hero .kpi-val.wk-paid{font-size:2.4rem;color:#fff;}
.od-list{display:flex;flex-direction:column;gap:.45rem;margin-top:.85rem;}
.od{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:.7rem;padding:.6rem .75rem;border-radius:10px;
  background:rgba(248,113,113,.06);border:1px solid rgba(248,113,113,.18);text-decoration:none;color:#fff;transition:border-color .2s;}
.od:hover{border-color:rgba(248,113,113,.5);}
.od .nm{font-weight:600;font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.od .sub{font-size:.74rem;color:rgba(255,255,255,.5);margin-top:.08rem;line-height:1.35;}
.od .amt{font-family:"Barlow Condensed",sans-serif;font-size:1.2rem;font-weight:800;color:#f87171;font-variant-numeric:tabular-nums;white-space:nowrap;}
.od-more{font-size:.76rem;color:rgba(255,255,255,.5);text-decoration:none;padding:.1rem .2rem;}
.od-more:hover{color:#F5A623;}
.od-caught{font-size:.76rem;color:#4ade80;margin-top:.7rem;}
.kpi{position:relative;overflow:hidden;}
.kpi-label{font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.5);}
.kpi-val{font-family:"Barlow Condensed",sans-serif;font-size:2.4rem;font-weight:900;line-height:1;margin-top:.55rem;letter-spacing:-.5px;font-variant-numeric:tabular-nums;}
.kpi.hero .kpi-val{font-size:3.4rem;color:#F5A623;}
.kpi-note{font-size:.8rem;color:rgba(255,255,255,.5);margin-top:.45rem;line-height:1.35;}
.kpi-note b{color:rgba(255,255,255,.85);font-weight:600;}
.delta{display:inline-flex;align-items:center;gap:.25rem;font-weight:700;font-size:.78rem;padding:.12rem .45rem;border-radius:6px;}
.delta.up{color:#4ade80;background:rgba(74,222,128,.1);}
.delta.down{color:#f87171;background:rgba(248,113,113,.1);}
.delta.flat{color:rgba(255,255,255,.6);background:rgba(255,255,255,.06);}
.kpi.bad .kpi-val{color:#f87171;}
.kpi.good .kpi-val{color:#4ade80;}
.meter{height:8px;border-radius:8px;background:rgba(245,166,35,.16);margin-top:.9rem;overflow:hidden;}
.meter i{display:block;height:100%;border-radius:8px;background:linear-gradient(90deg,#F5A623,#ffc861);}

/* Two-column rows */
.row2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr);gap:1rem;margin-bottom:1rem;}
.row2b{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:1rem;}

/* Fleet */
.util-num{font-family:"Barlow Condensed",sans-serif;font-size:3rem;font-weight:900;line-height:1;}
.util-num small{font-size:1.1rem;color:rgba(255,255,255,.5);font-weight:700;margin-left:.3rem;letter-spacing:0;}
.segbar{display:flex;gap:2px;height:14px;margin:1rem 0 .8rem;}
.segbar i{display:block;height:100%;min-width:4px;}
.segbar i:first-child{border-radius:7px 0 0 7px;}
.segbar i:last-child{border-radius:0 7px 7px 0;}
.segbar i:only-child{border-radius:7px;}
.key{display:grid;grid-template-columns:1fr auto;gap:.45rem .75rem;font-size:.85rem;}
.key span{display:flex;align-items:center;gap:.55rem;color:rgba(255,255,255,.75);}
.key i{width:10px;height:10px;border-radius:3px;display:inline-block;flex:0 0 auto;}
.key b{text-align:right;font-variant-numeric:tabular-nums;}
.fleet-split{border-top:1px solid rgba(255,255,255,.07);margin-top:1rem;padding-top:.9rem;display:flex;flex-wrap:wrap;gap:.5rem .9rem;font-size:.78rem;color:rgba(255,255,255,.6);}
.fleet-split span{display:inline-flex;align-items:center;gap:.4rem;}
.fleet-split i{width:9px;height:9px;border-radius:50%;}
.fleet-split b{color:#fff;}

/* Rent chart */
.chart{position:relative;height:210px;margin-top:.4rem;padding-left:42px;}
.chart .grid{position:absolute;left:42px;right:0;height:1px;background:rgba(255,255,255,.07);}
.chart .tick{position:absolute;left:0;width:36px;text-align:right;font-size:.68rem;color:rgba(255,255,255,.4);transform:translateY(-50%);font-variant-numeric:tabular-nums;}
.cols{position:absolute;left:42px;right:0;top:0;bottom:22px;display:flex;align-items:flex-end;}
.col{flex:1;height:100%;display:flex;align-items:flex-end;justify-content:center;position:relative;cursor:pointer;}
.col .due{position:absolute;bottom:0;width:min(22px,62%);border-radius:4px 4px 0 0;background:rgba(255,255,255,.09);box-shadow:inset 0 0 0 1px rgba(255,255,255,.14);}
.col .got{position:absolute;bottom:0;width:min(22px,62%);border-radius:4px 4px 0 0;background:#F5A623;}
.col.now .got{background:repeating-linear-gradient(135deg,#F5A623 0 4px,#c98612 4px 7px);}
.col:hover .due,.col.on .due{background:rgba(255,255,255,.16);}
.col .lbl{position:absolute;bottom:-20px;font-size:.66rem;color:rgba(255,255,255,.45);white-space:nowrap;}
.chart-legend{display:flex;gap:1rem;flex-wrap:wrap;font-size:.75rem;color:rgba(255,255,255,.6);}
.chart-legend span{display:inline-flex;align-items:center;gap:.4rem;}
.chart-legend i{width:12px;height:10px;border-radius:2px;display:inline-block;}
